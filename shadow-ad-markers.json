{
  "version": 1,
  "comment": "Маркеры рекламы для Shadow (1.6.0+). Регулярные выражения без учёта регистра; совпадение в тексте поста, скрытой ссылке, URL-кнопке или превью ссылки — пост скрывается. Реферальные ссылки сюда не добавлять. Пустой или битый файл игнорируется, тогда работает встроенный список.",
  "patterns": [
    {
      "regex": "(?<![a-z0-9])erid\\s*[:=]?\\s*[a-z0-9]{6,}",
      "note": "erid: токен из реестра рекламы, в тексте или в ссылке ?erid="
    },
    {
      "regex": "(реклама|рекламодатель)\\s*[.:,|\\-–—]?\\s*[«\\\"]?\\s*(ооо|оао|пао|зао|нао|ао|ип)(?![а-яё])",
      "note": "«Реклама. ООО …», «Рекламодатель: ИП …»"
    },
    {
      "regex": "(?<![а-яё])инн\\s*[:№]?\\s*\\d{10}(\\d{2})?(?!\\d)",
      "note": "ИНН рекламодателя (10 или 12 цифр)"
    },
    {
      "regex": "#(реклама|промо|ad|ads|sponsored|партн[её]рск[а-яё]*|спонсорск[а-яё]*)(?![a-zа-яё0-9_])",
      "note": "хэштеги #реклама, #промо, #ad, #партнёрский…"
    },
    {
      "regex": "на\\s+правах\\s+рекламы",
      "note": "«на правах рекламы»"
    },
    {
      "regex": "партн[её]рск(ий|ая|ое)\\s+(пост|материал|публикаци[яи])",
      "note": "«партнёрский пост/материал»"
    },
    {
      "regex": "рекламн(ый|ая|ое)\\s+(пост|материал|интеграци[яи]|запись|публикаци[яи])",
      "note": "«рекламный пост/материал/интеграция»"
    },
    {
      "regex": "(?m)^\\s*#?реклама\\s*[.!]?\\s*$",
      "note": "строка, в которой только «Реклама»"
    }
  ]
}
